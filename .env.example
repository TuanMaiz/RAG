OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Embeddings (unchanged)
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small

# LLM Models for different tasks
OPENAI_QUERY_MODEL=openai/gpt-4o-mini        # Query rewriting, judging
OPENAI_GENERATION_MODEL=openai/gpt-4o        # Final response generation
OPENAI_KG_MODEL=openai/gpt-4o-mini            # Entity/relationship extraction

# Legacy (fallback if specific models not set)
OPENAI_LLM_MODEL=openai/gpt-4o-mini          # Default model

# Logging
LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=rag.log        # Optional: write logs to file

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_documents
DENSE_WEIGHT=0.7

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
ENABLE_KG=true

# KG Entity Extraction
KG_ENTITY_TYPES=PERSON,ORGANIZATION,LOCATION,EVENT,CONCEPT,PRODUCT,DATE,OTHER
KG_BATCH_SIZE=10         # Number of documents per LLM call for entity extraction

# Indexing Performance
INDEXING_MAX_WORKERS=8          # Number of parallel extraction threads (default: 4)
INDEXING_BATCH_SIZE=350         # Documents per batch (default: 350)
INDEXING_MAX_MEMORY_GB=4        # Max memory for result queue (default: 4GB)
NEO4J_CONCURRENT_WRITES=false   # Enable concurrent Neo4j upserts (default: false - single writer)

# Streaming Indexer - Memory Management
SPILL_THRESHOLD_PCT=90         # Spill to disk at 90%
RESTORE_THRESHOLD_PCT=60       # Restore from disk at 60%
SPILL_PATH=./indexing_spill    # Where shelve files are written

# Streaming Indexer - Deduplication
GLOBAL_DEDUP_INTERVAL=10       # Batches between global dedup

# KG Extraction - Optimized Batch Size
KG_BATCH_SIZE=500              # Docs per LLM call (optimized for model context)
MODEL_TOKEN_LIMIT=128000       # Context window size
AVG_DOC_CHARS=500              # Average document character count
SAFETY_MARGIN=0.8              # Safety margin for token calculation

