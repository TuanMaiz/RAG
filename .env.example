OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Embeddings (unchanged)
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small

# LLM Models for different tasks
OPENAI_QUERY_MODEL=openai/gpt-4o-mini        # Query rewriting, judging
OPENAI_GENERATION_MODEL=openai/gpt-4o        # Final response generation
OPENAI_KG_MODEL=openai/gpt-4o-mini            # Entity/relationship extraction

# Legacy (fallback if specific models not set)
OPENAI_LLM_MODEL=openai/gpt-4o-mini          # Default model

# Logging
LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=rag.log        # Optional: write logs to file

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_documents
DENSE_WEIGHT=0.7

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
ENABLE_KG=true

# KG
KG_ENTITY_TYPES=PERSON,ORGANIZATION,LOCATION,EVENT,CONCEPT,PRODUCT,DATE,OTHER
KG_BATCH_SIZE=10         # Number of documents per LLM call for entity extraction

# KG Schema Version (1 = old with title in key, 2 = new without title)
KG_SCHEMA_VERSION=1

# Token-Aware Chunking (Phase 1)
KG_ENABLE_TOKEN_CHUNKING=false
KG_MIN_CHUNK_TOKENS=150
KG_MAX_CHUNK_TOKENS=512
KG_OVERLAP_TOKENS=50

# Entity Extraction Enhancements (Phase 2)
KG_USE_STRUCTURED_OUTPUT=true     # Use Pydantic models instead of delimited parsing
KG_ENABLE_GLEANING=true           # Enable second-pass extraction
KG_GLEANING_MAX_TOKENS=2000       # Skip gleaning if context exceeds this
KG_CACHE_PATH=.kg_extraction_cache.json

# In-Memory Deduplication (Phase 3 - requires schema v2)
KG_ENABLE_IN_MEMORY_DEDUP=false
KG_ALIAS_CONFIG_PATH=kg_aliases.json

# Domain-Aware Entity Types
KG_DOMAIN_AWARE_TYPES=true

# Indexing Performance
INDEXING_MAX_WORKERS=4      # Number of parallel batches for indexing (default: 4)
INDEXING_BATCH_SIZE=350     # Documents per batch (default: 350)

